<Window x:Class="TakojsnjeSporocanje.CustomThemeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tema po meri"
        Width="480" Height="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BrBgDeep}"
        FontFamily="Segoe UI">

    <Window.Resources>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BrTextSecondary}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="PickButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="{StaticResource BrBgTertiary}"/>
            <Setter Property="Foreground" Value="{StaticResource BrTextSecondary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrBorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.78"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PresetButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="{StaticResource BrBgSecondary}"/>
            <Setter Property="Foreground" Value="{StaticResource BrTextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrBorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="Tema po meri"
                   FontSize="20" FontWeight="SemiBold"
                   Foreground="{StaticResource BrTextPrimary}"/>

        <!-- Color pickers -->
        <Border Grid.Row="2"
                Background="{StaticResource BrBgSidebar}"
                CornerRadius="14"
                BorderBrush="{StaticResource BrBorderSubtle}"
                BorderThickness="1"
                Padding="16,14">
            <StackPanel>

                <!-- Background -->
                <TextBlock Text="Ozadje" FontSize="11" FontWeight="Bold"
                           Foreground="{StaticResource BrTextMuted}" Margin="0,0,0,5"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="BgSwatch" Grid.Column="0"
                            Width="36" Height="36" CornerRadius="8"/>
                    <TextBlock x:Name="BgHexText" Grid.Column="1"
                               FontFamily="Consolas" FontSize="13"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <Button Grid.Column="2" Content="Izberi..."
                            Style="{StaticResource PickButtonStyle}"
                            Click="PickBg_Click"/>
                </Grid>

                <!-- Accent -->
                <TextBlock Text="Poudarek (accent)" FontSize="11" FontWeight="Bold"
                           Foreground="{StaticResource BrTextMuted}" Margin="0,0,0,5"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="AccentSwatch" Grid.Column="0"
                            Width="36" Height="36" CornerRadius="8"/>
                    <TextBlock x:Name="AccentHexText" Grid.Column="1"
                               FontFamily="Consolas" FontSize="13"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <Button Grid.Column="2" Content="Izberi..."
                            Style="{StaticResource PickButtonStyle}"
                            Click="PickAccent_Click"/>
                </Grid>

                <!-- Text -->
                <TextBlock Text="Besedilo" FontSize="11" FontWeight="Bold"
                           Foreground="{StaticResource BrTextMuted}" Margin="0,0,0,5"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="TextSwatch" Grid.Column="0"
                            Width="36" Height="36" CornerRadius="8"/>
                    <TextBlock x:Name="TextHexText" Grid.Column="1"
                               FontFamily="Consolas" FontSize="13"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <Button Grid.Column="2" Content="Izberi..."
                            Style="{StaticResource PickButtonStyle}"
                            Click="PickText_Click"/>
                </Grid>

            </StackPanel>
        </Border>

        <!-- Preview label -->
        <TextBlock Grid.Row="4" Text="PREDOGLED"
                   FontSize="10" FontWeight="Bold"
                   Foreground="{StaticResource BrTextMuted}" Margin="2,0"/>

        <!-- Preview panel -->
        <Border Grid.Row="6" CornerRadius="14" ClipToBounds="True"
                BorderBrush="{StaticResource BrBorderSubtle}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Mini sidebar -->
                <Border x:Name="PvSidebar" Grid.Column="0">
                    <StackPanel Margin="10,10,10,10">
                        <Border x:Name="PvUserCard" CornerRadius="8" Padding="8,6" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="PvUserAvatar" Width="24" Height="24" CornerRadius="12"/>
                                <StackPanel Margin="6,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="PvUserName" Text="Tadej"
                                               FontSize="10" FontWeight="SemiBold"/>
                                    <Ellipse x:Name="PvStatusDot" Width="5" Height="5"
                                             Fill="#2DD4BF" HorizontalAlignment="Left" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border x:Name="PvContact1" CornerRadius="6" Padding="6,5" Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="PvContact1Av" Width="18" Height="18" CornerRadius="9"/>
                                <TextBlock x:Name="PvContact1Txt" Text="Niko"
                                           FontSize="10" Margin="5,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="PvContact2" CornerRadius="6" Padding="6,5">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="PvContact2Av" Width="18" Height="18" CornerRadius="9"/>
                                <TextBlock x:Name="PvContact2Txt" Text="Aljaž"
                                           FontSize="10" Margin="5,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Mini chat area -->
                <Border x:Name="PvChatArea" Grid.Column="1">
                    <StackPanel Margin="10,14">
                        <Border x:Name="PvBubbleIn" CornerRadius="8,8,8,2" Padding="8,5"
                                Margin="0,0,0,6" HorizontalAlignment="Left" MaxWidth="90">
                            <TextBlock x:Name="PvBubbleInTxt" Text="Živjo!"
                                       FontSize="10"/>
                        </Border>
                        <Border x:Name="PvBubbleOut" CornerRadius="8,8,2,8" Padding="8,5"
                                HorizontalAlignment="Right" MaxWidth="90">
                            <TextBlock Text="Hej!" FontSize="10" Foreground="White"/>
                        </Border>
                    </StackPanel>
                </Border>

            </Grid>
        </Border>

        <!-- Preset palettes -->
        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="🔵 Ocean" Style="{StaticResource PresetButtonStyle}"
                    Margin="4,0" Click="PresetOcean_Click"/>
            <Button Content="🟣 Grape" Style="{StaticResource PresetButtonStyle}"
                    Margin="4,0" Click="PresetGrape_Click"/>
            <Button Content="🟤 Mocha" Style="{StaticResource PresetButtonStyle}"
                    Margin="4,0" Click="PresetMocha_Click"/>
        </StackPanel>

        <!-- Action buttons -->
        <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Prekliči" Width="100" Height="42" Padding="0"
                    Background="{StaticResource BrBgSecondary}"
                    Foreground="{StaticResource BrTextSecondary}"
                    Margin="0,0,10,0"
                    Style="{StaticResource ActionButtonStyle}"
                    Click="Cancel_Click"/>
            <Button Content="Uporabi" Width="120" Height="42" Padding="0"
                    Foreground="White"
                    Style="{StaticResource ActionButtonStyle}"
                    Click="Apply_Click">
                <Button.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#4F46E5" Offset="0"/>
                        <GradientStop Color="#6366F1" Offset="1"/>
                    </LinearGradientBrush>
                </Button.Background>
            </Button>
        </StackPanel>

    </Grid>
</Window>
