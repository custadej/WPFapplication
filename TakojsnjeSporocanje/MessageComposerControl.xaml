<UserControl x:Class="TakojsnjeSporocanje.MessageComposerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="80"
             d:DesignWidth="760">
    <UserControl.Resources>
        <Style x:Key="ComposerGhostButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource BrTextMuted}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                Width="44"
                                Height="44"
                                Padding="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource BrHoverOverlay}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ComposerSendButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BrAccentGradient}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="14"
                                Height="44"
                                Padding="16,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource BrBgSecondary}"
            CornerRadius="20"
            BorderBrush="{StaticResource BrBorderSubtle}"
            BorderThickness="1"
            Padding="12">
        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="52"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>

            <!-- Text input area -->
            <Border Grid.Column="0"
                    Background="{StaticResource BrBgTertiary}"
                    BorderBrush="{StaticResource BrBorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="14,8"
                    Height="44"
                    VerticalAlignment="Center">
                <TextBox x:Name="ComposerTextBox"
                         Background="Transparent"
                         BorderThickness="0"
                         FontSize="14"
                         Foreground="{StaticResource BrTextPrimary}"
                         CaretBrush="{StaticResource BrAccent}"
                         Padding="0"
                         AcceptsReturn="True"
                         TextWrapping="WrapWithOverflow"
                         HorizontalScrollBarVisibility="Disabled"
                         VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Center"
                         Text="{Binding MessageText, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         TextChanged="ComposerTextBox_TextChanged"
                         KeyDown="ComposerTextBox_KeyDown"/>
            </Border>

            <!-- Emoji button -->
            <Button Grid.Column="1"
                    VerticalAlignment="Center"
                    Margin="6,0,0,0"
                    Style="{StaticResource ComposerGhostButtonStyle}"
                    Click="EmojiButton_Click">
                <Image Source="Images/smile.png" Width="20" Height="20"/>
            </Button>

            <!-- Send button -->
            <Button Grid.Column="2"
                    VerticalAlignment="Center"
                    Style="{StaticResource ComposerSendButtonStyle}"
                    Click="SendButton_Click">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Image Source="Images/send.png" Width="15" Height="15" Margin="0,0,6,0"/>
                    <TextBlock Text="Pošlji" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>
    </Border>
</UserControl>
