<Application x:Class="TakojsnjeSporocanje.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TakojsnjeSporocanje"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <!-- Colors — navy-blue premium palette -->
        <Color x:Key="ColBgDeep">#0A0F1E</Color>
        <Color x:Key="ColBgPrimary">#0F172A</Color>
        <Color x:Key="ColBgSecondary">#1E293B</Color>
        <Color x:Key="ColBgTertiary">#243347</Color>
        <Color x:Key="ColAccent">#3B82F6</Color>
        <Color x:Key="ColAccentSoft">#60A5FA</Color>
        <Color x:Key="ColTextPrimary">#E2E8F0</Color>
        <Color x:Key="ColTextSecondary">#94A3B8</Color>
        <Color x:Key="ColTextMuted">#4B6280</Color>
        <Color x:Key="ColOnline">#22C55E</Color>
        <Color x:Key="ColAway">#EAB308</Color>
        <Color x:Key="ColBusy">#EF4444</Color>
        <Color x:Key="ColBorderSubtle">#FFFFFF0F</Color>
        <Color x:Key="ColBorderGlow">#3B82F640</Color>

        <!-- Brushes -->
        <SolidColorBrush x:Key="BrBgDeep" Color="{StaticResource ColBgDeep}"/>
        <SolidColorBrush x:Key="BrBgPrimary" Color="{StaticResource ColBgPrimary}"/>
        <SolidColorBrush x:Key="BrBgSecondary" Color="{StaticResource ColBgSecondary}"/>
        <SolidColorBrush x:Key="BrBgTertiary" Color="{StaticResource ColBgTertiary}"/>
        <SolidColorBrush x:Key="BrAccent" Color="{StaticResource ColAccent}"/>
        <SolidColorBrush x:Key="BrAccentSoft" Color="{StaticResource ColAccentSoft}"/>
        <SolidColorBrush x:Key="BrTextPrimary" Color="{StaticResource ColTextPrimary}"/>
        <SolidColorBrush x:Key="BrTextSecondary" Color="{StaticResource ColTextSecondary}"/>
        <SolidColorBrush x:Key="BrTextMuted" Color="{StaticResource ColTextMuted}"/>
        <SolidColorBrush x:Key="BrOnline" Color="{StaticResource ColOnline}"/>
        <SolidColorBrush x:Key="BrAway" Color="{StaticResource ColAway}"/>
        <SolidColorBrush x:Key="BrBusy" Color="{StaticResource ColBusy}"/>
        <SolidColorBrush x:Key="BrBorderSubtle" Color="{StaticResource ColBorderSubtle}"/>
        <SolidColorBrush x:Key="BrBorderGlow" Color="{StaticResource ColBorderGlow}"/>

        <LinearGradientBrush x:Key="BrAccentGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#2563EB" Offset="0"/>
            <GradientStop Color="#3B82F6" Offset="1"/>
        </LinearGradientBrush>

        <!-- Dark thin scrollbar -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="4"/>
            <Setter Property="MinWidth" Value="4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Border Background="#FFFFFF08" CornerRadius="2"/>
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#3B82F680" CornerRadius="2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>
