<Application x:Class="TakojsnjeSporocanje.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TakojsnjeSporocanje"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <!-- ═══ RAW COLORS ═══ -->
        <Color x:Key="ColBgDeep">#0D0F1A</Color>
        <Color x:Key="ColBgSidebar">#1A1D2E</Color>
        <Color x:Key="ColBgPrimary">#1E2235</Color>
        <Color x:Key="ColBgSecondary">#242842</Color>
        <Color x:Key="ColBgTertiary">#2E3255</Color>
        <Color x:Key="ColAccent">#6366F1</Color>
        <Color x:Key="ColAccentSoft">#818CF8</Color>
        <Color x:Key="ColTextPrimary">#E2E8F0</Color>
        <Color x:Key="ColTextSecondary">#94A3B8</Color>
        <Color x:Key="ColTextMuted">#64748B</Color>
        <Color x:Key="ColOnline">#2DD4BF</Color>
        <Color x:Key="ColAway">#F97316</Color>
        <Color x:Key="ColBusy">#EF4444</Color>
        <Color x:Key="ColBorderSubtle">#10FFFFFF</Color>
        <Color x:Key="ColBorderGlow">#506366F1</Color>
        <Color x:Key="ColHoverOverlay">#0AFFFFFF</Color>
        <Color x:Key="ColAccentMuted">#3B3F6E</Color>

        <!-- ═══ BRUSHES ═══ -->
        <SolidColorBrush x:Key="BrBgDeep"        Color="{StaticResource ColBgDeep}"/>
        <SolidColorBrush x:Key="BrBgSidebar"     Color="{StaticResource ColBgSidebar}"/>
        <SolidColorBrush x:Key="BrBgPrimary"     Color="{StaticResource ColBgPrimary}"/>
        <SolidColorBrush x:Key="BrBgSecondary"   Color="{StaticResource ColBgSecondary}"/>
        <SolidColorBrush x:Key="BrBgTertiary"    Color="{StaticResource ColBgTertiary}"/>
        <SolidColorBrush x:Key="BrAccent"        Color="{StaticResource ColAccent}"/>
        <SolidColorBrush x:Key="BrAccentSoft"    Color="{StaticResource ColAccentSoft}"/>
        <SolidColorBrush x:Key="BrTextPrimary"   Color="{StaticResource ColTextPrimary}"/>
        <SolidColorBrush x:Key="BrTextSecondary" Color="{StaticResource ColTextSecondary}"/>
        <SolidColorBrush x:Key="BrTextMuted"     Color="{StaticResource ColTextMuted}"/>
        <SolidColorBrush x:Key="BrOnline"        Color="{StaticResource ColOnline}"/>
        <SolidColorBrush x:Key="BrAway"          Color="{StaticResource ColAway}"/>
        <SolidColorBrush x:Key="BrBusy"          Color="{StaticResource ColBusy}"/>
        <SolidColorBrush x:Key="BrBorderSubtle"  Color="{StaticResource ColBorderSubtle}"/>
        <SolidColorBrush x:Key="BrBorderGlow"    Color="{StaticResource ColBorderGlow}"/>
        <SolidColorBrush x:Key="BrHoverOverlay"  Color="{StaticResource ColHoverOverlay}"/>
        <SolidColorBrush x:Key="BrAccentMuted"   Color="{StaticResource ColAccentMuted}"/>

        <LinearGradientBrush x:Key="BrAccentGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#4F46E5" Offset="0"/>
            <GradientStop Color="#6366F1" Offset="1"/>
        </LinearGradientBrush>

        <!-- ═══ OVERRIDE WPF SYSTEM COLORS — kills yellow/orange highlights ═══ -->
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"                 Color="#2D3255"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"              Color="#E2E8F0"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#242842"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#94A3B8"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.MenuHighlightBrushKey}"              Color="#2D3255"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}"                   Color="#242842"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}"                Color="#E2E8F0"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}"                    Color="#1A1D2E"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}"                 Color="#E2E8F0"/>

        <!-- ═══ GLOBAL MENUITEM — unified violet hover ═══ -->
        <Style TargetType="MenuItem">
            <Setter Property="Background"       Value="Transparent"/>
            <Setter Property="Foreground"       Value="{StaticResource BrTextPrimary}"/>
            <Setter Property="BorderBrush"      Value="Transparent"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Padding"          Value="8,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemIconColumnGroup"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemIGTColumnGroup"/>
                                    <ColumnDefinition Width="14"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter x:Name="Icon"
                                                  Grid.Column="0"
                                                  Content="{TemplateBinding Icon}"
                                                  Width="16" Height="16"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,6,0"/>
                                <Border x:Name="GlyphPanel"
                                        Grid.Column="0"
                                        Visibility="Collapsed"
                                        Width="16" Height="16"
                                        VerticalAlignment="Center"
                                        Margin="0,0,6,0">
                                    <Path Data="M1.5,5 L5,9.5 L13,2"
                                          Stroke="{StaticResource BrAccent}"
                                          StrokeThickness="1.5"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Center"/>
                                </Border>
                                <ContentPresenter Grid.Column="1"
                                                  Content="{TemplateBinding Header}"
                                                  ContentTemplate="{TemplateBinding HeaderTemplate}"
                                                  ContentStringFormat="{TemplateBinding HeaderStringFormat}"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"/>
                                <TextBlock Grid.Column="2"
                                           Text="{TemplateBinding InputGestureText}"
                                           VerticalAlignment="Center"
                                           Margin="10,0,0,0"
                                           Opacity="0.6"/>
                                <Path x:Name="RightArrow"
                                      Grid.Column="3"
                                      Data="M0,0 L4,4 L0,8"
                                      Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="1.5"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Center"
                                      Visibility="Collapsed"/>
                                <Popup x:Name="PART_Popup"
                                       AllowsTransparency="True"
                                       Focusable="False"
                                       IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                       PopupAnimation="{DynamicResource {x:Static SystemParameters.MenuPopupAnimationKey}}"
                                       Placement="Right">
                                    <Border Background="{StaticResource BrBgSecondary}"
                                            BorderBrush="{StaticResource BrBorderSubtle}"
                                            BorderThickness="1"
                                            Padding="2">
                                        <ItemsPresenter x:Name="ItemsPresenter"
                                                        Grid.IsSharedSizeScope="True"
                                                        KeyboardNavigation.DirectionalNavigation="Cycle"
                                                        KeyboardNavigation.TabNavigation="Cycle"
                                                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Icon" Value="{x:Null}">
                                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="GlyphPanel" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Icon"        Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="HasItems" Value="True">
                                <Setter TargetName="RightArrow" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrAccentMuted}"/>
                                <Setter Property="Foreground"                   Value="{StaticResource BrAccent}"/>
                            </Trigger>
                            <Trigger Property="IsSubmenuOpen" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrAccentMuted}"/>
                                <Setter Property="Foreground"                   Value="{StaticResource BrAccent}"/>
                            </Trigger>
                            <Trigger Property="Role" Value="TopLevelHeader">
                                <Setter TargetName="PART_Popup" Property="Placement"  Value="Bottom"/>
                                <Setter TargetName="RightArrow" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="Role" Value="TopLevelItem">
                                <Setter TargetName="RightArrow" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ GLOBAL TOGGLEBUTTON — eliminates WPF default orange hover ═══ -->
        <Style TargetType="ToggleButton">
            <Setter Property="Background"       Value="Transparent"/>
            <Setter Property="BorderBrush"      Value="Transparent"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrHoverOverlay}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrBorderSubtle}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ GLOBAL BUTTON FALLBACK — eliminates WPF default yellow hover ═══ -->
        <Style TargetType="Button">
            <Setter Property="Background"       Value="Transparent"/>
            <Setter Property="BorderBrush"      Value="Transparent"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Foreground"       Value="{StaticResource BrTextSecondary}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ THIN SCROLLBAR ═══ -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width"      Value="4"/>
            <Setter Property="MinWidth"   Value="4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Border Background="{StaticResource BrBorderSubtle}" CornerRadius="2"/>
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border CornerRadius="2">
                                                    <Border.Background>
                                                        <SolidColorBrush Color="{StaticResource ColAccent}" Opacity="0.45"/>
                                                    </Border.Background>
                                                </Border>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>
